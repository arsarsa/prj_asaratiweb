          <field name="HIGHLIGHT_MODE">javascript</field>
          <field name="TEXT" editor-height="25" editor-width="852.2806320520505">// === SCROLL + HOVER AUTO-START ===&amp;#10;(function() {&amp;#10;    // Aspetta che Verge3D sia pronto&amp;#10;    function init() {&amp;#10;        if (typeof app === 'undefined') {&amp;#10;            setTimeout(init, 100);&amp;#10;            return;&amp;#10;        }&amp;#10;        &amp;#10;        const objProdFront = app.scene.getObjectByName('obj_prodFront');&amp;#10;        const objPopup = app.scene.getObjectByName('obj_popup');&amp;#10;        const elmCentro = app.scene.getObjectByName('elm_centro');&amp;#10;        &amp;#10;        // Nascondi popup&amp;#10;        if (objPopup) objPopup.visible = false;&amp;#10;        &amp;#10;        // Disabilita zoom&amp;#10;        if (app.controls) app.controls.enableZoom = false;&amp;#10;        &amp;#10;        // SCROLL&amp;#10;        window.addEventListener('wheel', (e) =&gt; {&amp;#10;            if (elmCentro) {&amp;#10;                elmCentro.rotation.x += e.deltaY * 0.0002;&amp;#10;                elmCentro.rotation.y += e.deltaY * 0.0001;&amp;#10;            }&amp;#10;        }, { passive: true });&amp;#10;        &amp;#10;        // HOVER&amp;#10;        const raycaster = new THREE.Raycaster();&amp;#10;        const mouse = new THREE.Vector2();&amp;#10;        window.addEventListener('mousemove', (e) =&gt; {&amp;#10;            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;&amp;#10;            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;&amp;#10;            raycaster.setFromCamera(mouse, app.scene.activeCamera);&amp;#10;            const intersects = raycaster.intersectObjects([objProdFront], true);&amp;#10;            objPopup.visible = intersects.length &gt; 0;&amp;#10;        }, { passive: true });&amp;#10;    }&amp;#10;    &amp;#10;    init();&amp;#10;})();&amp;#10;</field>
        </shadow>
