{
  "functions": [{
    "source": "functions",
    "codebase": "main",
    "runtime": "nodejs20"
  }],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/createPayment",
        "function": "createPayment"
      },
      {
        "source": "/generateDownloadUrl",
        "function": "generateDownloadUrl"
      },
      {
        "source": "/getStripeConfig",
        "function": "getStripeConfig"
      },
      {
        "source": "/checkPaymentStatus",
        "function": "checkPaymentStatus"
      },
      {
        "source": "/stripeWebhook",
        "function": "stripeWebhook"
      },
      {
        "source": "/success",
        "destination": "/success.html"
      },
      {
        "source": "!**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)",
        "destination": "/index.html"
      }
    ]
  }
}
